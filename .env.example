# Copy to `.env` and fill in. `.env` is gitignored — never commit the real DSN.
#
# Sentry DSN for crash reporting. Get it from:
#   sentry.io -> your project -> Settings -> Client Keys (DSN)
# Leave unset to disable crash reporting entirely (local dev default).
VITE_SENTRY_DSN=

# Build-only credentials used to upload JavaScript source maps and native dSYMs.
# These names are not exposed to the app bundle. Keep the real values only in
# the gitignored `.env` file.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=capacitor

# Public URL of the deployed reference-search function. No Google key belongs here.
VITE_YOUTUBE_SEARCH_ENDPOINT=
# Set YOUTUBE_DATA_API_KEY only in the YouTube proxy's Netlify environment.

# Dev-only: replaces getUserMedia with a synthetic camera + A440 mic so the UI
# can be viewed in a desktop browser. Build-time only, dead-coded when unset:
#   VITE_FAKE_MEDIA=1 npm run build
VITE_FAKE_MEDIA=
