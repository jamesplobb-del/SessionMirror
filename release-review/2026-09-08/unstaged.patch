-    if (
-      shiftedLow >= instrument.minWrittenMidi &&
-      shiftedHigh <= instrument.maxWrittenMidi
-    ) {
-      shift = octaves
-    }
-  }
-
-  return raw.map((midi) => clampWrittenMidi(midi + shift, instrument))
-}
