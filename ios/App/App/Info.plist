<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>BestTake</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.besttake.app.quick-tuner</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>besttake</string>
			</array>
		</dict>
	</array>
	<!-- Register PDFs and the three BestTake file types so Files and other apps
	     can offer BestTake as an Open In destination. iOS delivers copied files
	     through appUrlOpen; the extension selects the matching importer. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>PDF Sheet Music</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<!-- Default (not Alternate) lets Files and Quick Look offer a one-tap
			     "Open in BestTake" button next to Share, as forScore does. -->
			<key>LSHandlerRank</key><string>Default</string>
			<key>LSItemContentTypes</key><array><string>com.adobe.pdf</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>BestTake Multitrack Project</string>
			<key>CFBundleTypeRole</key><string>Editor</string>
			<key>LSHandlerRank</key><string>Owner</string>
			<key>LSItemContentTypes</key><array><string>com.besttake.app.multitrack</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>BestTake Practice Routine</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.besttake.app.practice-plan</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>BestTake Metronome Program</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.besttake.app.routine</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.besttake.app.multitrack</string>
			<key>UTTypeDescription</key><string>BestTake Multitrack Project</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
			<key>UTTypeTagSpecification</key><dict>
				<key>public.filename-extension</key><array><string>btmulti</string></array>
			<key>public.mime-type</key><string>application/vnd.besttake.multitrack</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.besttake.app.practice-plan</string>
			<key>UTTypeDescription</key>
			<string>BestTake Practice Routine</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>btplan</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.besttake.practice-plan</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.besttake.app.routine</string>
			<key>UTTypeDescription</key>
			<string>BestTake Metronome Program</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>btroutine</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.besttake.metronome-program</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- True so Files and Messages offer a one-tap "Open in BestTake" beside Share
	     (as forScore does). The sender's file is never edited: AppDelegate copies
	     it into the app while it holds the security-scoped access. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAudio</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Open Tuner</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.besttake.app.quickTuner</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeTime</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Open Metronome</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.besttake.app.quickMetronome</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>music.note.list</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Continue Music</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.besttake.app.recentMusic</string>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSMotionUsageDescription</key>
	<string>BestTake rotates on-screen controls when you turn your phone sideways.</string>
	<key>NSCameraUsageDescription</key>
	<string>BestTake needs the camera to record practice takes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>BestTake uses the microphone to record takes and to hear your playing in the tuner, hands-free mode, and practice games.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>BestTake uses speech recognition when you choose to dictate a note for your next take.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>BestTake needs permission to save your takes to Photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>BestTake saves your recorded takes to your Photos library. It does not read or upload your existing photos or videos.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
